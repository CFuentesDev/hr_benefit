<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_benefit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.benefit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='work_email']" position="before">
                <field name="employee_type" widget="selection"/>
                <xpath expr="//field[@name='category_ids']" position="move"/>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <label for="identification_id" string="Cédula de Identidad"/>
                <h3>
                    <div class="d-flex flex-row align-items-center">
                        <field name="identification_type" class="oe_inline" nolabel="1" style="width: auto !important; margin-right: 5px !important; flex-grow: 0;"/>
                        <field name="cedula" placeholder="Cédula de Identidad" class="oe_inline" style="width: auto !important; flex-grow: 0;"/>
                    </div>
                </h3>
            </xpath>

            <xpath expr="//field[@name='job_title']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='work_email']/../field[@name='company_id']" position="replace">
                </xpath>

            <xpath expr="//field[@name='department_id']" position="before">
                <field name="company_id" groups="base.group_multi_company"/>
            </xpath>

            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="domain">[('company_id', '=', company_id)]</attribute>
            </xpath>

            <xpath expr="//field[@name='job_id']" position="attributes">
                <attribute name="string">Cargo Administrativo</attribute>
            </xpath>
            
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="string">Director/Gerente</attribute>
            </xpath>
            
            <xpath expr="//field[@name='coach_id']" position="attributes">
                <attribute name="string">Supervisor</attribute>
            </xpath>

        </field>
    </record>
</odoo>